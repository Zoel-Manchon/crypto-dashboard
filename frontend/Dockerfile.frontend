FROM node:22-alpine

WORKDIR /app
COPY package.json package-lock.json ./
# ci, not install: the lockfile is the audited one, so the image gets exactly
# the dependency set that passed `npm audit` in CI.
RUN npm ci

COPY . .
RUN chown -R node:node /app

USER node
EXPOSE 4321
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
