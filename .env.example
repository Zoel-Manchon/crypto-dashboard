DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/crypto_dashboard
DB_MAX_CONNECTIONS=5
DB_SSL_MODE=require
DB_CA_CERT_PATH=
POLL_INTERVAL_SECONDS=60

# How many coins to track, ranked by market cap (top-N). Default: 25
TRACKED_COINS_LIMIT=25
# How often to re-discover/re-rank that coin set, in seconds. Default: 3600 (1h)
COIN_REFRESH_SECONDS=3600

# Security
# Exact allowed CORS origin (e.g. http://localhost:4321). Empty = allow any (dev).
CORS_ALLOWED_ORIGIN=
# Max requests per IP per minute (0 disables).
RATE_LIMIT_PER_MIN=120

# Auth
# Secret for signing session JWTs (use `openssl rand -base64 48` in prod).
JWT_SECRET=dev-secret-change-me
# Session lifetime in hours.
TOKEN_TTL_HOURS=24

# Frontend (Astro) — all optional, defaults match the dev docker-compose.
# PUBLIC_ vars are inlined at build time and are visible in the browser, so put
# nothing secret here.
PUBLIC_API_BASE_URL=http://127.0.0.1:8080
PUBLIC_WS_URL=ws://127.0.0.1:8080/api/ws
PUBLIC_GRAFANA_URL=http://localhost:3000
PUBLIC_PROMETHEUS_URL=http://localhost:9090
PUBLIC_ALERTMANAGER_URL=http://localhost:9093
PUBLIC_GRAFANA_DASHBOARD_UID=crypto-watch
